# Non-secret example configuration. Copy to .env (git-ignored). Never commit real values.
# Names and defaults are PROVISIONAL until measured on the target machine.
# See docs/CONFIGURATION.md.

# --- Server ---
VISTA_HOST=127.0.0.1
VISTA_PORT=8000
VISTA_LOG_LEVEL=INFO

# --- Upload and image limits (provisional) ---
VISTA_MAX_UPLOAD_BYTES=10485760
VISTA_MAX_IMAGE_SIDE=6000
VISTA_MAX_IMAGE_PIXELS=20000000
VISTA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# --- Execution and resources (provisional) ---
VISTA_WORKER_CONCURRENCY=1
VISTA_QUEUE_MAX_SIZE=4
VISTA_TASK_TIMEOUT_SECONDS=60
VISTA_MAX_RESIDENT_MODELS=1
VISTA_MODEL_IDLE_UNLOAD_SECONDS=120

# --- Provider policy: local_only | hybrid | external_fallback ---
VISTA_POLICY_DEFAULT=local_only
VISTA_EXTERNAL_ENABLED=false
VISTA_EXTERNAL_RETRY_MAX=2
VISTA_EXTERNAL_TIMEOUT_SECONDS=30
# Leave empty; set real keys only in your private .env
VISTA_EXTERNAL_API_KEY=

# --- Privacy ---
VISTA_RETAIN_RAW_IMAGES=false
VISTA_TEMP_DIR=./tmp
VISTA_LOG_REDACT=true

# --- OCR (added with the OCR MVP) ---
VISTA_OCR_ENGINE=rapidocr
# Larger images are downscaled to this longest side for inference; boxes map back to original pixels
VISTA_OCR_MAX_SIDE=1600

# --- Model residency (shared by OCR and detection) ---
# VISTA_MAX_RESIDENT_MODELS (above) now limits heavy models in RAM across OCR and detection: with 1, an idle
# model is unloaded before the other loads. Idle-timeout unloading (VISTA_MODEL_IDLE_UNLOAD_SECONDS) is NOT implemented.
# How long a request waits for another model to become idle before failing with MODEL_BUSY (429, retryable)
VISTA_MODEL_ACQUIRE_TIMEOUT_SECONDS=30

# --- Object detection (Phase 3; provisional until measured on the target machine) ---
VISTA_DETECTION_ENABLED=true
VISTA_DETECTION_BACKEND=yolox-onnx
# Model file is NOT in the repository. Install it with: python -m scripts.fetch_detection_model
VISTA_DETECTION_MODEL_PATH=models/yolox_nano.onnx
VISTA_DETECTION_MODEL_ID=yolox-nano
# Optional integrity pin (64 hex chars); empty = do not verify. Values: see docs/DETECTION.md
VISTA_DETECTION_MODEL_SHA256=
# Must equal the model's fixed input size (YOLOX nano/tiny: 416)
VISTA_DETECTION_INPUT_SIZE=416
VISTA_DETECTION_CONF_THRESHOLD=0.30
VISTA_DETECTION_NMS_IOU=0.45
VISTA_DETECTION_MAX_DETECTIONS=100
# 0 = let ONNX Runtime choose the thread count
VISTA_DETECTION_THREADS=0
