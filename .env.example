# Non-secret example configuration. Copy to .env. Never commit real values.
# All names are proposals and become final in Phase 1 (see ai/DECISION_LOG.md).
VISTA_HOST=127.0.0.1
VISTA_PORT=8000
VISTA_LOG_LEVEL=INFO
VISTA_MAX_UPLOAD_BYTES=10485760
VISTA_MAX_IMAGE_PIXELS=25000000
VISTA_MAX_IMAGE_SIDE=8000
VISTA_ALLOWED_MIME=image/jpeg,image/png,image/webp
VISTA_RETAIN_RAW_IMAGES=false
VISTA_TEMP_DIR=./tmp
